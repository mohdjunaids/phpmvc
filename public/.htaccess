<IfModule mod_rewrite.c>
    Options -MultiViews
    RewriteEngine On
    RewriteBase /shareposts/public/
  
    # Check if the request is not a directory
    RewriteCond %{REQUEST_FILENAME} !-d
    # Check if the request is not a file
    RewriteCond %{REQUEST_FILENAME} !-f
    # Redirect all other requests to index.php with the 'url' query parameter
    RewriteRule ^(.+)$ index.php?url=$1 [QSA,L]
</IfModule>
